    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["runserver", "--settings=OrchardLodge.settings.production"],
            "django": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
        },
        {
            "name": "Santander Scraper",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/get_santander_data.py",
            "args": ["1/1/2017"],
            "console": "integratedTerminal",
        }
    ]
}